# Copy to .env and fill in. The server reads these on start.

# Postgres connection URL.
DATABASE_URL=postgres://sisyphus:change-me@localhost:5432/sisyphus

# Address the server listens on.
BIND_ADDR=0.0.0.0:8080

# The URL people reach the server at, without a trailing slash. Must be
# https in production: cookies are only marked Secure on https.
PUBLIC_URL=https://sisyphus.example.com

# Hack Club Auth app (https://auth.hackclub.com/developer/apps).
# When registering it, set the redirect URI to PUBLIC_URL + /auth/callback,
# e.g. https://sisyphus.example.com/auth/callback
# Keep the secret private: only the server may know it.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Optional: Hack Club Auth's address (default https://auth.hackclub.com).
# Plain http is only accepted for a provider on this machine (testing).
# HACKCLUB_AUTH_URL=https://auth.hackclub.com
